{
  "name": "movieverse",
  "version": "1.0.0",
  "private": true,
  "description": "MovieVerse - Full-stack MERN cinema exploration portal",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "build": "npm run build --workspace=frontend && node -e \"require('fs').cpSync('frontend/dist', 'dist', {recursive: true})\"",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "install:all": "npm install"
  },
  "keywords": [
    "mern",
    "react",
    "express",
    "mongodb",
    "tmdb",
    "vercel"
  ],
  "author": "Premshiva"
}
